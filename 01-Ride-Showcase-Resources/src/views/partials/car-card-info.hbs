<div class="car-card car-card-info">
  <div class="front">
    <img src="{{image}}" alt="{{model}}" />
  </div>
  <div class="back">
    <h1>{{model}}</h1>
    <h2>Top Speed: {{topSpeed}} kmph</h2>
    <p>Description: {{description}}</p>
    <a href="/cars/{{_id}}/details" class="details">Details</a>
  </div>
</div>