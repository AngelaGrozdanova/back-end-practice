<div class="loginSection">
  <div class="info">
    <h2>Please enter your username and password to log in and explore the
      world's most exotic rides</h2>
  </div>
  <form action="/auth/login" method="POST" class="loginForm">
    <h2>Login</h2>
    <ul class="ul-wrap">
      <li>
        <label for="email">Email:</label>
        <input
          type="text"
          class="inputFields"
          id="email"
          name="email"
          placeholder="alex@gmail.com"
          value="{{email}}"
        />
      </li>
      <li>
        <label for="password">Password:</label>
        <input
          type="password"
          class="inputFields"
          id="password"
          name="password"
          placeholder="*******"
        />
      </li>

      <li id="center-btn">
        <button id="login-btn">Login</button>
      </li>
    </ul>
  </form>
</div>