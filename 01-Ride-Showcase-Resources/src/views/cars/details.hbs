<section id="details-page">
  <div class="main_card">
    <div class="card_left">
      <div class="card-details">

        <h1>Model: {{model}}</h1>
        <h3>Posted by: {{carOwner.name}} {{carOwner.lastName}}</h3>

        <div class="card-specs">
          <p class="card-manufacturer">Manufacturer: {{manufacturer}}</p>
          <p class="card-engine">Engine Type: {{engine}}</p>
          <p class="card-top-speed">Top Speed: {{topSpeed}} kmph</p>
        </div>

        <p class="disc">
          Description:
          {{description}}
        </p>

        <!-- If there is no registered user, do not display buttons-->
        <div class="social-btn">
          {{#if user}}
            {{#if isOwner}}

              <!-- Only for registered user and author of the post -->
              <a href="/cars/{{_id}}/edit" class="edit-btn">Edit</a>
              <a href="/cars/{{_id}}/delete" class="del-btn">Delete</a>
              <!-- logged in users, who have not yet liked-->
            {{else}}
              {{#if hasLiked}}
                <p class="you-liked">Thanks For The Like</p>
              {{else}}
                <a href="/cars/{{_id}}/like" class="like-btn">Like</a>
              {{/if}}
            {{/if}}
          {{/if}}
          <!-- logged in user who has already liked-->
        </div>

      </div>
    </div>
    <div class="card_right">
      <img src="{{image}}" alt="{{model}}" />
    </div>
  </div>
</section>

<section id="likes">
  <div class="like-info">
    <div class="card_left">
      <div class="card-details">
        <h1>Likes</h1>
        <div class="card-like">
          <!-- Show total likes -->
          <p class="PV">Total likes: {{likesCount}}</p>
        </div>

        {{#if likedUsers.length}}
          <p class="disc">
            People who liked the post –
            {{#each likedUsers}}
              {{this.email}}{{#unless @last}}, {{/unless}}
            {{/each}}
          </p>
        {{else}}
          <p class="disc">People who liked the post – No one has liked yet.</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>