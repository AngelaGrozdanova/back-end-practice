<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <title>Home Page</title>

    <!-- Do not forget to change the path to the css file -->
    <link href="/static/css/style.css" type="text/css" rel="stylesheet" />
  </head>

  <body>

    <div id="box">

      {{#if error}}
        <div class="error-container">
          <p>{{error}}</p>
        </div>
      {{/if}}
      <!-- In case of error, you should display div with class "error-container" -->
      <!-- You can choose to display the first error or all of them (error message/s in your opinion) -->
      <!--
        <div class="error-container">
            <p>Error</p>
        </div>-->

      <nav>
        <!-- Do not forget to change the path to the image -->
        <img src="/static/img/logo.png" alt="logo" />

        <ul class="menu">
          <li><a href="/">Home</a></li>
          <li><a href="/cars/catalog">Browse Rides</a></li>

          <!-- Logged users -->
          {{#if user}}
            <li><a href="/cars/create-offer">Post a Car</a></li>
            <li><a href="/my-posts">My Showcase</a></li>
            <li><a href="/auth/logout">Logout</a></li>

            <!-- Guest users -->
          {{else}}
            <li><a href="/auth/login">Login</a></li>
            <li><a href="/auth/register">Register</a></li>
          {{/if}}
        </ul>

      </nav>

      <main>

        {{{body}}}
      </main>

      <footer>
        © JS Back-End Exam 2025
      </footer>
    </div>

  </body>

</html>