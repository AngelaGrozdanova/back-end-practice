<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/static/styles/styles.css" />
    <title>Home Page</title>
  </head>

  <body>

    {{#if error}}
      <div>
        <div class="errorContainer">
          <p>{{error}}</p>
        </div>
      </div>
    {{/if}}

    <!-- <div>
        <div class="errorContainer">
            <p>Error</p>
        </div>
    </div> -->

    <div id="wrapper">
      <header>
        <!-- Navigation -->
        <nav>
          <div>
            <a href="/">Home</a>
            <a href="/myths/catalog">Dashboard</a>
            <a href="/report">Report</a>
          </div>

          <!-- Logged-in users -->
          {{#if user}}
            <div class="user">
              <a href="/myths/create-offer">Add Myth</a>
              <a href="/auth/logout">Logout</a>
            </div>
          {{else}}
            <!-- Guest users -->
            <div class="guest">
              <a href="/auth/login">Login</a>
              <a href="/auth/register">Register</a>
            </div>
          {{/if}}
        </nav>
      </header>

      <main class="home">
        <!-- Home page -->
        {{{body}}}
      </main>
    </div>
    <footer>SoftUni JS Back-End Exam 2025 &copy;</footer>
  </body>

</html>